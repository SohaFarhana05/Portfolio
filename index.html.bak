    <main class="home-container">
        <section class="hero-section">
            <div class="text-content">
                <div class="creative-heading">
                    <span class="greeting-text">Welcome! 👋</span>
                    <h1 class="gradient-text" id="typing-h1"></h1>
                    <p class="subtitle" id="typing-p"></p>
                </div>
                <div class="tagline">
                    <p>AI Engineering Intern at PepsiCo | Love to code & create!</p>
                </div>
                <div class="quick-links">
                    <a href="https://github.com/SohaFarhana05" target="_blank" class="social-link">
                        <img src="Photos/github-icon.png" alt="GitHub" class="social-icon" loading="lazy">
                    </a>
                    <a href="https://leetcode.com/u/_Soha_Farhana/" target="_blank" class="social-link">
                        <img src="Photos/leetcode-logo.png" alt="LeetCode" class="social-icon" loading="lazy">
                    </a>
                    <a href="https://codeforces.com/profile/Soha_Farhana" target="_blank" class="social-link">
                        <img src="Photos/codeforces.png" alt="Codeforces" class="social-icon" loading="lazy">
                    </a>
                    <a href="https://www.linkedin.com/messaging/compose/?to=SohaFarhana" target="_blank" class="social-link">
                        <img src="Photos/linkedin-icon.png" alt="LinkedIn" class="social-icon" loading="lazy">
                    </a>
                </div>
            </div>
            <div class="photo-container">
                <div class="photo-frame">
                    <img src="Photos/soha.jpg" alt="Soha Farhana" class="profile-image" loading="lazy">
                </div>
            </div>
        </section>

